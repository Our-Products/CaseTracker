# Deployment Credentials for MonsterASP.net
# You can set these in GitHub Secrets OR locally in a .env file (do not commit .env with real passwords to public repos)

WEBSITE_NAME=site90440
SERVER_COMPUTER_NAME=https://site90440.siteasp.net:8172
SERVER_USERNAME=site90440
SERVER_PASSWORD=your_password_here

# Alternative naming convention supported as well:
# WEBDEPLOY_SITE=site90440
# WEBDEPLOY_SERVER=https://site90440.siteasp.net:8172
# WEBDEPLOY_USERNAME=site90440
# WEBDEPLOY_PASSWORD=your_password_here
