<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaseTrackerMobile.Controls.ShadcnBadge"
             x:Name="thisBadge">

    <Border BackgroundColor="{Binding BadgeColor, Source={x:Reference thisBadge}, FallbackValue='#16253D'}"
            Stroke="{Binding BorderColor, Source={x:Reference thisBadge}, FallbackValue='#233554'}"
            StrokeThickness="1"
            Padding="10,4"
            HorizontalOptions="Start">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="14" />
        </Border.StrokeShape>

        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
            <Label Text="{Binding Icon, Source={x:Reference thisBadge}}"
                   FontSize="11"
                   TextColor="{Binding TextColor, Source={x:Reference thisBadge}, FallbackValue='#CBD5E1'}"
                   IsVisible="{Binding Icon, Source={x:Reference thisBadge}, Converter={StaticResource Key=IsNotNullOrEmptyConverter}}"
                   VerticalOptions="Center" />

            <Label Text="{Binding Text, Source={x:Reference thisBadge}}"
                   FontSize="11"
                   FontAttributes="Bold"
                   TextColor="{Binding TextColor, Source={x:Reference thisBadge}, FallbackValue='#CBD5E1'}"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Border>

</ContentView>
