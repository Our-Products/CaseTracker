<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaseTrackerMobile.Controls.ShadcnMetricCard"
             x:Name="thisMetric">

    <Border BackgroundColor="White"
            Stroke="#E2E8F0"
            StrokeThickness="1"
            Padding="16,14">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>

        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.05" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="8">
            <!-- Header Row: Title & Icon Badge -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="{Binding MetricTitle, Source={x:Reference thisMetric}}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#64748B"
                       VerticalOptions="Center" />

                <Border Grid.Column="1"
                        BackgroundColor="{Binding IconBgColor, Source={x:Reference thisMetric}, FallbackValue='#F1F5F9'}"
                        StrokeThickness="0"
                        HeightRequest="36"
                        WidthRequest="36">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Grid HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="{Binding MetricIcon, Source={x:Reference thisMetric}}"
                               FontFamily="FontAwesomeSolid"
                               FontSize="16"
                               TextColor="#113979"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Metric Big Number -->
            <Label Text="{Binding MetricValue, Source={x:Reference thisMetric}}"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#0F172A" />

            <!-- Subtitle / Trend Badge -->
            <Label Text="{Binding Subtitle, Source={x:Reference thisMetric}}"
                   FontSize="11"
                   TextColor="#94A3B8"
                   IsVisible="{Binding Subtitle, Source={x:Reference thisMetric}, Converter={StaticResource Key=IsNotNullOrEmptyConverter}}" />
        </VerticalStackLayout>
    </Border>

</ContentView>
