<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaseTrackerMobile.Controls.ShadcnCard"
             x:Name="thisCard">

    <Border BackgroundColor="{Binding CardColor, Source={x:Reference thisCard}, FallbackValue='White'}"
            Stroke="{Binding StrokeColor, Source={x:Reference thisCard}, FallbackValue='#E2E8F0'}"
            StrokeThickness="1"
            Padding="{Binding CardPadding, Source={x:Reference thisCard}, FallbackValue='24'}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{Binding CornerRadius, Source={x:Reference thisCard}, FallbackValue='16'}" />
        </Border.StrokeShape>

        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.06" />
        </Border.Shadow>

        <ContentPresenter />
    </Border>

</ContentView>
