<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaseTrackerMobile.Controls.ShadcnButton"
             x:Name="thisButton">

    <Border x:Name="ButtonBorder"
            BackgroundColor="{Binding ButtonColor, Source={x:Reference thisButton}, FallbackValue='#113979'}"
            StrokeThickness="0"
            HeightRequest="52"
            Padding="16,0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="8" />
        </Border.StrokeShape>

        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnButtonTapped" />
        </Border.GestureRecognizers>

        <Grid HorizontalOptions="Center" VerticalOptions="Center">
            <!-- Normal Button Text -->
            <Label Text="{Binding Text, Source={x:Reference thisButton}}"
                   TextColor="{Binding TextColor, Source={x:Reference thisButton}, FallbackValue='White'}"
                   FontSize="15"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   IsVisible="{Binding IsLoading, Source={x:Reference thisButton}, Converter={StaticResource Key=InvertedBoolConverter}, FallbackValue=True}" />

            <!-- Activity Indicator on Loading -->
            <ActivityIndicator IsRunning="{Binding IsLoading, Source={x:Reference thisButton}}"
                               IsVisible="{Binding IsLoading, Source={x:Reference thisButton}}"
                               Color="White"
                               HeightRequest="24"
                               WidthRequest="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>
    </Border>

</ContentView>
