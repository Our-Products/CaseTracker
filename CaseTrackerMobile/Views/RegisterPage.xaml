<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CaseTrackerMobile.Controls"
             xmlns:viewmodels="clr-namespace:CaseTrackerMobile.ViewModels"
             x:Class="CaseTrackerMobile.Views.RegisterPage"
             x:DataType="viewmodels:RegisterViewModel"
             Title="Create Account"
             BackgroundColor="#0B1528"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        
        <!-- Header Section -->
        <Grid Grid.Row="0" Padding="20,24,20,16" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="Advocate Registration" FontSize="24" FontAttributes="Bold" TextColor="White" />
                <Label Text="Join CaseTracker for Legal Case Management" FontSize="13" TextColor="#94A3B8" />
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="✕"
                    BackgroundColor="#16253D"
                    TextColor="White"
                    FontSize="16"
                    CornerRadius="20"
                    WidthRequest="40"
                    HeightRequest="40"
                    Command="{Binding CloseCommand}"
                    VerticalOptions="Start" />
        </Grid>

        <!-- Form Scroll Container (Tablet Responsive MaxWidth=640) -->
        <ScrollView Grid.Row="1">
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="24,24,24,32"
                    MaximumWidthRequest="640"
                    HorizontalOptions="Center"
                    Margin="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="32,32,0,0" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="16">
                    
                    <!-- Account Type Selector -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Account Type" FontSize="13" FontAttributes="Bold" TextColor="#334155" />
                        <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="4">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Picker SelectedIndex="{Binding SelectedRegisterTypeIndex}"
                                    TextColor="#0F172A"
                                    FontSize="14"
                                    Margin="8,0">
                                <Picker.Items>
                                    <x:String>Individual Advocate</x:String>
                                    <x:String>Law Firm / Organization</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="Advocate Profile Details" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" Margin="0,4,0,0" />

                    <!-- Full Name -->
                    <controls:ShadcnEntry LabelText="Full Name *"
                                          Text="{Binding FullName}"
                                          Placeholder="e.g. Adv. R. Sundaram"
                                          HasError="{Binding HasFullNameError}"
                                          ErrorText="{Binding FullNameError}" />

                    <!-- Mobile Number -->
                    <controls:ShadcnEntry LabelText="Mobile Number *"
                                          Text="{Binding MobileNumber}"
                                          Placeholder="9876543210"
                                          Keyboard="Telephone"
                                          HasError="{Binding HasMobileNumberError}"
                                          ErrorText="{Binding MobileNumberError}" />

                    <!-- Email Address -->
                    <controls:ShadcnEntry LabelText="Email Address *"
                                          Text="{Binding Email}"
                                          Placeholder="advocate@example.com"
                                          Keyboard="Email"
                                          HasError="{Binding HasEmailError}"
                                          ErrorText="{Binding EmailError}" />

                    <!-- Bar Council ID & Date -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <controls:ShadcnEntry Grid.Column="0"
                                              LabelText="Bar Council ID *"
                                              Text="{Binding BarCouncilId}"
                                              Placeholder="TN/1042/2018"
                                              HasError="{Binding HasBarCouncilIdError}"
                                              ErrorText="{Binding BarCouncilIdError}" />

                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Enrollment Date" FontSize="13" FontAttributes="Bold" TextColor="#334155" />
                            <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="8,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <DatePicker Date="{Binding EnrollmentDate}" Format="yyyy-MM-dd" TextColor="#0F172A" FontSize="13" HeightRequest="46" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Law Firm Card (Organization Mode) -->
                    <Border IsVisible="{Binding IsAssociates}" BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Law Firm Information" FontAttributes="Bold" FontSize="15" TextColor="#0F172A" />

                            <controls:ShadcnEntry LabelText="Firm Name *"
                                                  Text="{Binding LawFirmName}"
                                                  Placeholder="Chambers / Firm Name" />

                            <controls:ShadcnEntry LabelText="Registration Number"
                                                  Text="{Binding LawFirmRegistration}"
                                                  Placeholder="Ref / Registration Number" />

                            <controls:ShadcnEntry LabelText="Address"
                                                  Text="{Binding LawFirmAddress}"
                                                  Placeholder="Address Line 1" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <controls:ShadcnEntry Grid.Column="0" LabelText="City" Text="{Binding City}" Placeholder="City" />
                                <controls:ShadcnEntry Grid.Column="1" LabelText="District" Text="{Binding District}" Placeholder="District" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="5">
                                    <Label Text="State" FontSize="13" FontAttributes="Bold" TextColor="#334155" />
                                    <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="4">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Picker ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState}" TextColor="#0F172A" FontSize="13" />
                                    </Border>
                                </VerticalStackLayout>
                                <controls:ShadcnEntry Grid.Column="1" LabelText="Pincode" Text="{Binding PincodeStr}" Placeholder="Pincode" Keyboard="Numeric" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Password Fields -->
                    <Label Text="Security &amp; Password" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" Margin="0,4,0,0" />

                    <controls:ShadcnEntry LabelText="Password *"
                                          Text="{Binding Password}"
                                          Placeholder="At least 6 characters"
                                          IsPassword="True"
                                          HasError="{Binding HasPasswordError}"
                                          ErrorText="{Binding PasswordError}" />

                    <controls:ShadcnEntry LabelText="Confirm Password *"
                                          Text="{Binding ConfirmPassword}"
                                          Placeholder="Repeat password"
                                          IsPassword="True"
                                          HasError="{Binding HasConfirmPasswordError}"
                                          ErrorText="{Binding ConfirmPasswordError}" />

                    <!-- Submit Button -->
                    <controls:ShadcnButton Text="Complete Registration"
                                          Command="{Binding ExecuteRegisterCommand}"
                                          IsLoading="{Binding IsBusy}"
                                          ButtonColor="#113979"
                                          Margin="0,12,0,0" />

                    <Label Text="By registering, you agree to our Terms &amp; Conditions and Privacy Policy."
                           FontSize="11"
                           TextColor="#94A3B8"
                           HorizontalTextAlignment="Center"
                           Margin="0,4,0,0" />

                </VerticalStackLayout>
            </Border>
        </ScrollView>

    </Grid>

</ContentPage>
