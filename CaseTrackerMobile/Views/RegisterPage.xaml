<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaseTrackerMobile.Views.RegisterPage"
             Title="Create Account"
             Shell.NavBarIsVisible="False">

    <ContentPage.ToolbarItems>
        <!-- Use FontAwesome solid close icon. Ensure fa-solid-900.ttf is added to Resources/Fonts and registered in MauiProgram.cs as FontAwesomeSolid -->
        <ToolbarItem Priority="0" Order="Primary" Command="{Binding CloseCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF00D;" Color="White" Size="18" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="18" VerticalOptions="Center">

            <!-- top-right close button (text fallback) to ensure visibility on all platforms -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- empty space on left to push button to right -->
                <Label Grid.Column="0" />

                <!-- simple text button as reliable fallback for exit/close -->
                <Button Grid.Column="1" Text="✕" BackgroundColor="Transparent" TextColor="White" FontSize="20" Command="{Binding CloseCommand}" Clicked="OnCloseClicked" HorizontalOptions="End" />
            </Grid>

            <Image Source="app.jpg" HeightRequest="72" HorizontalOptions="Center" />

            <Label Text="Create Account" FontSize="24" HorizontalOptions="Center" TextColor="White" />
            <Label Text="Join CaseTracker today" FontSize="14" HorizontalOptions="Center" TextColor="White" />

            <Frame CornerRadius="12" Padding="18" HasShadow="True" BackgroundColor="White" Margin="0,12">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Advocate Registration" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" />

                    <!-- Registration type picker -->
                    <Label Text="Register As" FontSize="14" />
                    <Picker Title="Select type" SelectedIndex="{Binding SelectedRegisterTypeIndex}" >
                        <Picker.Items>
                            <x:String>Individual</x:String>
                            <x:String>Organization</x:String>
                        </Picker.Items>
                    </Picker>

                    <!-- Law firm details shown only when Associates selected -->
                    <Frame IsVisible="{Binding IsAssociates}" Padding="10" CornerRadius="8" BackgroundColor="#F5F5F5">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Law Firm Details" FontAttributes="Bold" />
                            <Entry Text="{Binding LawFirmName}" Placeholder="Firm Name" />
                            <Entry Text="{Binding LawFirmRegistration}" Placeholder="Registration Number" />
                            <Editor Text="{Binding LawFirmAddress}" Placeholder="Address (optional)" AutoSize="TextChanges" HeightRequest="80" />
                        </VerticalStackLayout>
                    </Frame>

                    <Entry Text="{Binding FullName}" Placeholder="Full Name" />
                    <Entry Text="{Binding MobileNumber}" Placeholder="Mobile Number" Keyboard="Telephone" />
                    <Entry Text="{Binding Email}" Placeholder="Email Address" Keyboard="Email" />
                    <Entry Text="{Binding Password}" Placeholder="Password" IsPassword="True" />
                    <Entry Text="{Binding ConfirmPassword}" Placeholder="Confirm Password" IsPassword="True" />
                    <Button Text="Create Account" BackgroundColor="#0B1320" TextColor="White" Command="{Binding RegisterCommand}" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="By registering, you agree to our Terms &amp; Conditions" FontSize="12" HorizontalOptions="Center" TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
