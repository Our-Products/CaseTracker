<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaseTrackerMobile.Views.LoginPage"
             Title="Login"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="18" VerticalOptions="Center">

            <Image Source="app.jpg" HeightRequest="80" HorizontalOptions="Center" />

            <Label Text="CaseTracker" FontSize="28" HorizontalOptions="Center" TextColor="White" />
            <Label Text="Professional Case Management for Advocates" FontSize="14" HorizontalOptions="Center" TextColor="White" />


            <Frame CornerRadius="12" Padding="18" HasShadow="True" BackgroundColor="White" Margin="0,12">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Login to your account" FontAttributes="Bold" FontSize="18" />

                    <Entry Text="{Binding Mobile}" Placeholder="Enter your mobile number" Keyboard="Telephone" />
                    <Entry Text="{Binding Password}" Placeholder="Enter your password" IsPassword="True" />

                    <Label Text="Forgot Password?" TextColor="#DAA520" HorizontalOptions="End" />

                    <Button Text="Login" BackgroundColor="#0B1320" TextColor="White" Command="{Binding LoginCommand}" />

                    <HorizontalStackLayout HorizontalOptions="Center">
                        <Label Text="Don't have an account?" />
                        <Label Text=" Register Now" TextColor="#DAA520">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRegisterTapped" NumberOfTapsRequired="1" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <Label Text="Serving Advocates across Tamil Nadu and Puducherry" FontSize="12" HorizontalOptions="Center" TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
