<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaseTrackerMobile.Views.StartupSplashPage"
             BackgroundColor="#0D1117"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto">
        <!-- Main Centered Content: Video Loader & App Title -->
        <VerticalStackLayout Grid.Row="0"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="20">
            
            <!-- Video Loader Card Container -->
            <Border WidthRequest="260"
                    HeightRequest="260"
                    BackgroundColor="#0D1117"
                    Stroke="#F59E0B"
                    StrokeThickness="1.5"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#F59E0B" Offset="0,0" Radius="20" Opacity="0.3" />
                </Border.Shadow>
                
                <Grid HeightRequest="256" WidthRequest="256" HorizontalOptions="Center" VerticalOptions="Center">
                    <WebView x:Name="LoaderVideoView"
                             BackgroundColor="#0D1117"
                             HeightRequest="256"
                             WidthRequest="256"
                             HorizontalOptions="Center"
                             VerticalOptions="Center" />

                    <!-- Fallback 3D Golden Scales Logo View -->
                    <VerticalStackLayout x:Name="FallbackLogoView"
                                         Spacing="12"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         IsVisible="False">
                        <Border x:Name="ScalesLogoBorder"
                                WidthRequest="110"
                                HeightRequest="110"
                                BackgroundColor="#161B22"
                                Stroke="#F59E0B"
                                StrokeThickness="2"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="55" />
                            </Border.StrokeShape>
                            <Grid HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="&#xf0e3;"
                                       FontFamily="FontAwesomeSolid"
                                       FontSize="52"
                                       TextColor="#F59E0B"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- App Title & Subtitle -->
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                <Label Text="CTRACKER"
                       TextColor="#F59E0B"
                       FontSize="26"
                       FontAttributes="Bold"
                       CharacterSpacing="4"
                       HorizontalOptions="Center" />

                <Label Text="Advocate Legal Management Workspace"
                       TextColor="#9CA3AF"
                       FontSize="13"
                       CharacterSpacing="1"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Loading Status Text -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,6,0,0">
                <Label x:Name="StatusLabel"
                       Text="Loading Advocate Environment..."
                       TextColor="#93C5FD"
                       FontSize="12"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- Bottom Footer Badge with FontAwesome Shield -->
        <Border Grid.Row="1"
                BackgroundColor="#161B22"
                Stroke="#30363D"
                StrokeThickness="1"
                Padding="16,8"
                Margin="0,0,0,24"
                HorizontalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Label Text="&#xf3ed;" FontFamily="FontAwesomeSolid" FontSize="13" TextColor="#F59E0B" VerticalOptions="Center" />
                <Label Text="eCourts Core • EF Virtual DB Engine v1.0"
                       TextColor="#8B949E"
                       FontSize="11"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>
    </Grid>

</ContentPage>
