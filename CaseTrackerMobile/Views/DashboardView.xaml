<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaseTrackerMobile.Views.DashboardView">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Dashboard" FontSize="20" HorizontalOptions="Center" />

            <!-- Placeholder content; user will provide actual content later -->
            <BoxView HeightRequest="300" Color="#F3F4F6" CornerRadius="8" />
            <BoxView HeightRequest="200" Color="#F3F4F6" CornerRadius="8" />
            <BoxView HeightRequest="400" Color="#F3F4F6" CornerRadius="8" />
        </VerticalStackLayout>
    </ScrollView>

</ContentView>