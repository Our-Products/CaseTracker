<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CaseTrackerMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CaseTrackerMobile"
    xmlns:views="clr-namespace:CaseTrackerMobile.Views"
    Title="CaseTrackerMobile">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="Login" />

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>
