<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:CaseTrackerMobile.Views"
             x:Class="CaseTrackerMobile.MainPage">

    <Grid RowDefinitions="* , Auto">
        <!-- Content area (swappable) -->
        <ContentView x:Name="ContentArea" Grid.Row="0" BackgroundColor="Transparent" />

        <!-- Fixed bottom navigation bar -->
        <Border Grid.Row="1" BackgroundColor="#FFFFFF" Stroke="#E5E5E5" StrokeThickness="1">
            <Grid Padding="8" ColumnDefinitions="*,*,*,*,*">
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                    <ImageButton WidthRequest="36" HeightRequest="36" BackgroundColor="Transparent" Clicked="OnDashboardClicked">
                        <ImageButton.Source>
                            <FontImageSource FontFamily="MaterialIcons" Glyph="dashboard" Color="#11192F" Size="28" />
                        </ImageButton.Source>
                    </ImageButton>
                    <Label Text="Dashboard" FontSize="12" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                    <ImageButton WidthRequest="36" HeightRequest="36" BackgroundColor="Transparent" Clicked="OnCasesClicked">
                        <ImageButton.Source>
                            <FontImageSource FontFamily="MaterialIcons" Glyph="gavel" Color="#11192F" Size="28" />
                        </ImageButton.Source>
                    </ImageButton>
                    <Label Text="Cases" FontSize="12" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                    <ImageButton WidthRequest="36" HeightRequest="36" BackgroundColor="Transparent" Clicked="OnClientsClicked">
                        <ImageButton.Source>
                            <FontImageSource FontFamily="MaterialIcons" Glyph="groups" Color="#11192F" Size="28" />
                        </ImageButton.Source>
                    </ImageButton>
                    <Label Text="Clients" FontSize="12" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="2">
                    <ImageButton WidthRequest="36" HeightRequest="36" BackgroundColor="Transparent" Clicked="OnDocumentsClicked">
                        <ImageButton.Source>
                            <FontImageSource FontFamily="MaterialIcons" Glyph="description" Color="#11192F" Size="28" />
                        </ImageButton.Source>
                    </ImageButton>
                    <Label Text="Documents" FontSize="12" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" Spacing="2">
                    <ImageButton WidthRequest="36" HeightRequest="36" BackgroundColor="Transparent" Clicked="OnProfileClicked">
                        <ImageButton.Source>
                            <FontImageSource FontFamily="MaterialIcons" Glyph="person" Color="#11192F" Size="28" />
                        </ImageButton.Source>
                    </ImageButton>
                    <Label Text="Profile" FontSize="12" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>

</ContentPage>
